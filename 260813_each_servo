import serial
import time

arduino = serial.Serial('COM8', 9600)   # 실제 COM 번호로 수정
time.sleep(2)

print("==== Servo Control ====")
print("Servo 번호: 1 ~ 4")
print("각도 범위: -90 ~ 90")
print("종료하려면 q 입력")

while True:
    servo = input("\n서보 번호 선택 (1~4): ")
    if servo == 'q':
        break
    if servo not in ['1','2','3','4']:
        print("잘못된 서보 번호")
        continue

    angle = input("각도 입력 (-90~90): ")
    if angle == 'q':
        break
    try:
        angle = int(angle)
    except:
        print("숫자를 입력하세요")
        continue
    if angle < -90 or angle > 90:
        print("각도 범위는 -90 ~ 90 입니다")
        continue

    servo_angle = angle + 90
    command = f"{servo},{servo_angle}\n"
    arduino.write(command.encode())
    print(f"Servo {servo} → {angle}° (servo:{servo_angle})")
