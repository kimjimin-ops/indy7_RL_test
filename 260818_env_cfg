# ==== LEGO 스터드 기하 (bricksim.units 와 동일, native author.cppm 규약) ====
BRICK_UNIT_LENGTH = 0.008     # 스터드 피치 (m)
PLATE_UNIT_HEIGHT = 0.0032    # 플레이트 1단 높이 (m)
BRICK_STUD_HEIGHT = 0.0017    # 스터드 돌출 높이 (m)

TARGET_BRICK_DIMS = (3, 2, 3)   # target_brick 의 (L, W, H) — 씬 정의와 반드시 일치

# ==== 엔드툴 브릭 부착 상수 (bricksim_smoke.py 와 반드시 일치) ====
ENDTOOL_LOCAL_POS = (0.0, 0.0, 0.1799)              # link6 로컬 오프셋
ENDTOOL_LOCAL_QUAT = (0.0, 0.70711, -0.70711, 0.0)  # X180+Z90 (스터드 아래/홀 위)
ENDTOOL_BRICK_DIMS = (3, 2, 3)


def _hole_local_offsets(dims, device, dtype=torch.float32) -> torch.Tensor:
    """브릭 로컬 기준 밑면 홀 중심들 (N, 3). 스터드와 같은 격자, z=0 (밑면)."""
    L, W, _ = dims
    xs = (torch.arange(L, dtype=dtype, device=device) - (L - 1) / 2.0) * BRICK_UNIT_LENGTH
    ys = (torch.arange(W, dtype=dtype, device=device) - (W - 1) / 2.0) * BRICK_UNIT_LENGTH
    gx, gy = torch.meshgrid(xs, ys, indexing="ij")
    z = torch.zeros_like(gx)                          # 밑면
    return torch.stack([gx, gy, z], dim=-1).reshape(-1, 3)


def endtool_hole_positions_w(env: ManagerBasedRLEnv,
                             asset_cfg: SceneEntityCfg) -> torch.Tensor:
    """엔드툴 브릭 홀들의 월드 위치 (E, N, 3). link6 pose ∘ 부착오프셋 ∘ 홀격자."""
    from isaaclab.utils.math import quat_mul
    asset = env.scene[asset_cfg.name]
    l6_pos = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    l6_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    E = l6_pos.shape[0]
    dev, dt = l6_pos.device, l6_pos.dtype

    att_pos = torch.tensor([ENDTOOL_LOCAL_POS], device=dev, dtype=dt).expand(E, -1)
    att_quat = torch.tensor([ENDTOOL_LOCAL_QUAT], device=dev, dtype=dt).expand(E, -1)

    # 브릭 원점의 월드 pose
    brick_pos = l6_pos + quat_apply(l6_quat, att_pos)
    brick_quat = quat_mul(l6_quat, att_quat)

    # 홀 격자를 월드로
    local = _hole_local_offsets(ENDTOOL_BRICK_DIMS, dev, dt)          # (N, 3)
    N = local.shape[0]
    local_b = local.unsqueeze(0).expand(E, N, 3).reshape(E * N, 3)
    quat_b = brick_quat.unsqueeze(1).expand(E, N, 4).reshape(E * N, 4)
    return quat_apply(quat_b, local_b).reshape(E, N, 3) + brick_pos.unsqueeze(1)

def hole_stud_alignment_reward(env: ManagerBasedRLEnv,
                               asset_cfg: SceneEntityCfg,
                               object_cfg: SceneEntityCfg,
                               eps: float = 0.001,      # 1mm — log 발산 방지 + 포화점
                               d_far: float = 0.5) -> torch.Tensor:
    """IndustReal SDF 보상의 keypoint 버전: r = -log(mean_pair_dist + eps).
    홀-스터드 6쌍 평균거리가 줄수록 보상이 가파르게 증가 (정밀 구간 민감)."""
    holes = endtool_hole_positions_w(env, asset_cfg)          # (E, 6, 3)
    studs = stud_positions_w(env, object_cfg)                 # (E, 6, 3)
    pair_dist = torch.norm(holes - studs, dim=-1)             # (E, 6)
    mean_dist = pair_dist.mean(dim=-1)                        # (E,)
    # 정규화: 멀리서는 0 근처, eps 도달 시 최대. log(d_far/eps) 로 나눠 0~1 스케일.
    r = torch.log(torch.clamp(mean_dist, max=d_far) + eps)
    r_max = math.log(eps)          # mean_dist→0 일 때
    r_far = math.log(d_far + eps)  # 멀 때
    return (r_far - r) / (r_far - r_max)   # 0 (멀다) → 1 (완전 정렬)


def assembly_connected(env: ManagerBasedRLEnv,
                       object_cfg: SceneEntityCfg) -> torch.Tensor:
    """env별 엔드툴↔타깃 결합 여부 (0/1). 스텝당 1회만 실제 질의 (캐싱)."""
    from bricksim.core import are_parts_connected
    step = int(env.common_step_counter)
    if getattr(env, "_conn_cache_step", -1) == step:
        return env._conn_cache
    out = torch.zeros(env.num_envs, device=env.device)
    for i in range(env.num_envs):
        et = f"/World/envs/env_{i}/EndtoolBrick"
        tgt = f"/World/envs/env_{i}/TargetBrick"
        try:
            if are_parts_connected(et, tgt):
                out[i] = 1.0
        except Exception:
            pass
    env._conn_cache_step = step
    env._conn_cache = out
    return out

def success_bonus(env: ManagerBasedRLEnv,
                  object_cfg: SceneEntityCfg,
                  z_table: float = 0.89,
                  h_success: float = 0.05) -> torch.Tensor:
    """결합+5cm lift 달성 순간의 일시 보너스 (종료 보상)."""
    brick = env.scene[object_cfg.name]
    h = brick.data.root_state_w[:, 2] - z_table
    conn = assembly_connected(env, object_cfg)
    return conn * (h > h_success).float()


def assembled_lift_reward(env: ManagerBasedRLEnv,
                          object_cfg: SceneEntityCfg,
                          z_table: float = 0.89,     # 테이블 윗면 (브릭 초기 z)
                          max_h: float = 0.10) -> torch.Tensor:
    """결합된 상태에서만 브릭 상승 높이에 비례 보상 (0~1)."""
    brick = env.scene[object_cfg.name]
    h = brick.data.root_state_w[:, 2] - z_table
    conn = assembly_connected(env, object_cfg)
    return conn * torch.clamp(h / max_h, min=0.0, max=1.0)


def assembled_and_lifted(env: ManagerBasedRLEnv,
                         object_cfg: SceneEntityCfg,
                         z_table: float = 0.89,
                         h_success: float = 0.05) -> torch.Tensor:
    """성공 종료 조건: 결합 + 5cm 이상 들어올림."""
    brick = env.scene[object_cfg.name]
    h = brick.data.root_state_w[:, 2] - z_table
    conn = assembly_connected(env, object_cfg)
    return (conn > 0.5) & (h > h_success)

def _stud_local_offsets(dims, device, dtype=torch.float32) -> torch.Tensor:
    """브릭 로컬 기준 스터드 밑면 중심들 (N_studs, 3). 원점=밑면 중심."""
    L, W, H = dims
    xs = (torch.arange(L, dtype=dtype, device=device) - (L - 1) / 2.0) * BRICK_UNIT_LENGTH
    ys = (torch.arange(W, dtype=dtype, device=device) - (W - 1) / 2.0) * BRICK_UNIT_LENGTH
    gx, gy = torch.meshgrid(xs, ys, indexing="ij")
    z = torch.full_like(gx, H * PLATE_UNIT_HEIGHT)   # 몸통 윗면 (스터드 밑면)
    return torch.stack([gx, gy, z], dim=-1).reshape(-1, 3)   # (L*W, 3)


def stud_positions_w(env: ManagerBasedRLEnv, object_cfg: SceneEntityCfg,
                     dims=TARGET_BRICK_DIMS) -> torch.Tensor:
    """타깃 브릭의 모든 스터드 월드 위치 (num_envs, N_studs, 3)."""
    brick = env.scene[object_cfg.name]
    pos = brick.data.root_state_w[:, :3]                     # (E, 3)
    quat = brick.data.root_state_w[:, 3:7]                   # (E, 4) wxyz
    local = _stud_local_offsets(dims, pos.device, pos.dtype) # (N, 3)
    E, N = pos.shape[0], local.shape[0]
    local_b = local.unsqueeze(0).expand(E, N, 3).reshape(E * N, 3)
    quat_b = quat.unsqueeze(1).expand(E, N, 4).reshape(E * N, 4)
    world = quat_apply(quat_b, local_b).reshape(E, N, 3) + pos.unsqueeze(1)
    return world                                             # (E, N, 3)


def target_stud_pos_obs(env: ManagerBasedRLEnv, object_cfg: SceneEntityCfg,
                        stud_index: int = 0) -> torch.Tensor:
    """특정 스터드 하나의 위치 (로봇 base 기준). 관측용."""
    robot = env.scene["robot"]
    studs = stud_positions_w(env, object_cfg)                # (E, N, 3)
    return studs[:, stud_index, :] - robot.data.root_state_w[:, :3]


def ee_to_stud_distance(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg,
                        object_cfg: SceneEntityCfg,
                        stud_index: int = 0) -> torch.Tensor:
    """TCP → 특정 스터드 거리 보상 (기존 ee_to_cube_distance 의 스터드 버전)."""
    asset = env.scene[asset_cfg.name]
    ee_pos = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    ee_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    local_offset = torch.tensor([[0.0, 0.0, 0.34]], device=ee_pos.device).expand(ee_pos.shape[0], -1)
    tcp_pos = ee_pos + quat_apply(ee_quat, local_offset)
    stud = stud_positions_w(env, object_cfg)[:, stud_index, :]   # (E, 3)
    distance = torch.norm(tcp_pos - stud, dim=1)
    return 1.0 - torch.tanh(distance / 0.5)

def ee_position_w(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
    from isaaclab.utils.math import quat_apply
    asset = env.scene[asset_cfg.name]
    ee_pos  = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    ee_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    local_offset = torch.tensor([[0.0, 0.0, 0.27]], device=ee_pos.device).expand(ee_pos.shape[0], -1)
    world_offset = quat_apply(ee_quat, local_offset)
    tcp_pos = ee_pos + world_offset
    return tcp_pos - asset.data.root_state_w[:, :3]


def cube_position_w(env: ManagerBasedRLEnv, object_cfg: SceneEntityCfg) -> torch.Tensor:
    """타깃(레고) 월드 위치를 로봇 베이스 기준 상대좌표로."""
    robot = env.scene["robot"]
    cube = env.scene[object_cfg.name]
    return cube.data.root_state_w[:, :3] - robot.data.root_state_w[:, :3]


def _place_gate(cube_z: torch.Tensor, z_init: float, g_lo: float, g_hi: float) -> torch.Tensor:
    """공용 게이트: lift 높이 h=cube_z-z_init 가 g_lo~g_hi 를 지나며 0→1."""
    h = cube_z - z_init
    return torch.clamp((h - g_lo) / (g_hi - g_lo), min=0.0, max=1.0)


def conditional_cube_lifted(
    env: ManagerBasedRLEnv,
    asset_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,
    distance_threshold: float,
    z_init: float,
    g_lo: float,
    g_hi: float) -> torch.Tensor:
    from isaaclab.utils.math import quat_apply
    """EE가 타깃에 가까울 때 들어올림 보상. place 게이트가 열린 만큼 페이드아웃."""
    asset = env.scene[asset_cfg.name]
    cube = env.scene[object_cfg.name]

    ee_pos = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    ee_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    local_offset = torch.tensor([[0.0, 0.0, 0.27]], device=ee_pos.device).expand(ee_pos.shape[0], -1)
    world_offset = quat_apply(ee_quat, local_offset)
    tcp_pos = ee_pos + world_offset

    cube_pos = cube.data.root_state_w[:, :3]
    distance = torch.norm(tcp_pos - cube_pos, dim=1)
    is_close = distance < distance_threshold

    lift_height = cube_pos[:, 2] - z_init
    is_lifted = lift_height >= 0.01

    lift_reward = torch.clamp(lift_height * 100.0, min=0.0, max=10.0)
    lift_value = is_close.float() * is_lifted.float() * lift_reward

    gate = _place_gate(cube_pos[:, 2], z_init, g_lo, g_hi)
    return (1.0 - gate) * lift_value


def place_reward(
    env: ManagerBasedRLEnv,
    object_cfg: SceneEntityCfg,
    goal_xy: tuple = (0.0, -0.4),
    z_place: float = 0.035,
    z_carry: float = 0.2,
    d_near: float = 0.3,
    d_max: float = 0.5,
    z_tol: float = 0.05,
    z_init: float = 0.025,
    g_lo: float = 0.05,
    g_hi: float = 0.15,
) -> torch.Tensor:
    """선형(clamp) 기반 place 보상 (reach 1차에서는 weight=0)."""
    robot = env.scene["robot"]
    cube = env.scene[object_cfg.name]

    cube_rel = cube.data.root_state_w[:, :3] - robot.data.root_state_w[:, :3]
    x = cube_rel[:, 0]
    y = cube_rel[:, 1]
    z = cube_rel[:, 2]

    gx, gy = goal_xy
    d_xy = torch.sqrt((x - gx) ** 2 + (y - gy) ** 2)

    ratio = torch.clamp(d_xy / d_near, min=0.0, max=1.0)
    z_target = z_place + (z_carry - z_place) * ratio

    r_approach = torch.clamp(1.0 - d_xy / d_max, min=0.0, max=1.0)
    r_height = torch.clamp(1.0 - torch.abs(z - z_target) / z_tol, min=0.0, max=1.0)
    gate = _place_gate(cube_rel[:, 2], z_init, g_lo, g_hi)
    return gate * r_approach * (1.0 + r_height)


def ee_pointing_down(
    env: ManagerBasedRLEnv,
    asset_cfg: SceneEntityCfg,) -> torch.Tensor:
    """link6의 로컬 +z축이 월드 아래(-z)를 향할수록 보상 (0~1)."""
    from isaaclab.utils.math import quat_apply

    asset = env.scene[asset_cfg.name]
    ee_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]

    z_unit = torch.tensor([[0.0, 0.0, 1.0]], device=env.device).expand(env.num_envs, -1)
    ee_z = quat_apply(ee_quat, z_unit)

    align_down = -ee_z[:, 2]
    return torch.clamp(align_down, min=0.0, max=1.0)


def ee_to_cube_distance(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg, object_cfg: SceneEntityCfg) -> torch.Tensor:
    from isaaclab.utils.math import quat_apply
    asset = env.scene[asset_cfg.name]
    cube  = env.scene[object_cfg.name]
    ee_pos  = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    ee_quat = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    local_offset = torch.tensor([[0.0, 0.0, 0.34]], device=ee_pos.device).expand(ee_pos.shape[0], -1)
    world_offset = quat_apply(ee_quat, local_offset)
    tcp_pos = ee_pos + world_offset
    cube_pos = cube.data.root_state_w[:, :3]
    distance = torch.norm(tcp_pos - cube_pos, dim=1)
    return 1.0 - torch.tanh(distance / 0.5)


def contact_penalty(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
    """로봇 링크가 지면과 접촉하면 패널티"""
    asset = env.scene[asset_cfg.name]
    body_pos_z = asset.data.body_state_w[:, asset_cfg.body_ids, 2]
    contact = (body_pos_z < 0.1).any(dim=1).float()
    return contact


def gripper_auto_reward(
    env: ManagerBasedRLEnv,
    asset_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,
    close_dist: float = 0.02,) -> torch.Tensor:
    """타깃 근처에서 닫힘, 멀면 열림 유도 (현재 미사용)"""
    asset = env.scene[asset_cfg.name]
    cube  = env.scene[object_cfg.name]

    ee_pos   = asset.data.body_state_w[:, asset_cfg.body_ids[0], :3]
    cube_pos = cube.data.root_state_w[:, :3]
    dist     = torch.norm(ee_pos - cube_pos, dim=1)

    grip_pos = asset.data.joint_pos[:, -2:]
    grip_avg = grip_pos.mean(dim=1)

    near = (dist <= close_dist)
    target_grip = torch.where(near,
        torch.zeros_like(grip_avg),
        torch.full_like(grip_avg, 0.015),
    )

    grip_error = torch.abs(grip_avg - target_grip)
    return 1.0 - torch.tanh(grip_error / 0.005)


def ee_cube_axis_alignment(
    env: ManagerBasedRLEnv,
    asset_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,) -> torch.Tensor:
    """link6의 x,y축이 타깃의 x,y축과 일치할수록 보상"""
    from isaaclab.utils.math import quat_apply

    asset = env.scene[asset_cfg.name]
    cube  = env.scene[object_cfg.name]

    ee_quat   = asset.data.body_state_w[:, asset_cfg.body_ids[0], 3:7]
    cube_quat = cube.data.root_state_w[:, 3:7]

    x_unit = torch.tensor([[1.0, 0.0, 0.0]], device=env.device).expand(env.num_envs, -1)
    y_unit = torch.tensor([[0.0, 1.0, 0.0]], device=env.device).expand(env.num_envs, -1)

    ee_x   = quat_apply(ee_quat,   x_unit)
    ee_y   = quat_apply(ee_quat,   y_unit)
    cube_x = quat_apply(cube_quat, x_unit)
    cube_y = quat_apply(cube_quat, y_unit)

    align_x = torch.sum(ee_x * cube_x, dim=1)
    align_y = torch.sum(ee_y * cube_y, dim=1)

    reward = (torch.abs(align_x) + torch.abs(align_y)) / 2.0
    return reward


_cube_markers = None


def draw_cube_axes(env: ManagerBasedRLEnv, object_cfg: SceneEntityCfg) -> torch.Tensor:
    """타깃 중심점에 x,y,z 축 시각화 (weight=0, 디버그용)"""
    from isaaclab.utils.math import quat_apply
    from isaaclab.markers import VisualizationMarkers, VisualizationMarkersCfg

    global _cube_markers

    cube = env.scene[object_cfg.name]
    num_envs = env.num_envs
    device = env.device

    if _cube_markers is None:
        marker_cfg = VisualizationMarkersCfg(
            prim_path="/Visuals/cube_axes",
            markers={
                "x_axis": sim_utils.CylinderCfg(
                    radius=0.35, height=0.7,
                    visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(1.0, 0.0, 0.0)),
                ),
                "y_axis": sim_utils.CylinderCfg(
                    radius=0.35, height=0.7,
                    visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(0.0, 1.0, 0.0)),
                ),
                "z_axis": sim_utils.CylinderCfg(
                    radius=0.35, height=0.7,
                    visual_material=sim_utils.PreviewSurfaceCfg(diffuse_color=(0.0, 0.0, 1.0)),
                ),
            },
        )
        _cube_markers = VisualizationMarkers(marker_cfg)

    cube_pos  = cube.data.root_state_w[:, :3]
    cube_quat = cube.data.root_state_w[:, 3:7]

    x_axis = torch.tensor([[0.05, 0.0, 0.0]], device=device).expand(num_envs, -1)
    y_axis = torch.tensor([[0.0, 0.05, 0.0]], device=device).expand(num_envs, -1)
    z_axis = torch.tensor([[0.0, 0.0, 0.05]], device=device).expand(num_envs, -1)

    x_pos = cube_pos + quat_apply(cube_quat, x_axis)
    y_pos = cube_pos + quat_apply(cube_quat, y_axis)
    z_pos = cube_pos + quat_apply(cube_quat, z_axis)

    q_x = torch.tensor([[0.7071, 0.0, -0.7071, 0.0]], device=device).expand(num_envs, -1)
    q_y = torch.tensor([[0.7071, 0.7071, 0.0, 0.0]], device=device).expand(num_envs, -1)
    q_z = torch.tensor([[1.0, 0.0, 0.0, 0.0]], device=device).expand(num_envs, -1)

    from isaaclab.utils.math import quat_mul
    q_x_world = quat_mul(cube_quat, q_x)
    q_y_world = quat_mul(cube_quat, q_y)
    q_z_world = quat_mul(cube_quat, q_z)

    translations = torch.cat([x_pos, y_pos, z_pos], dim=0)
    orientations = torch.cat([q_x_world, q_y_world, q_z_world], dim=0)
    marker_indices = torch.tensor(
        [0]*num_envs + [1]*num_envs + [2]*num_envs, device=device
    )

    _cube_markers.visualize(
        translations=translations,
        orientations=orientations,
        marker_indices=marker_indices,
    )

    return torch.zeros(num_envs, device=device)


