        self.sim.dt = 1.0 / 120.0
        self.sim.render_interval = self.decimation
        self.sim.device = "cpu"             # BrickSim weld 제약 — CPU 강제
        self.sim.use_fabric = False         # Fabric 비활성 (BrickSim 필수)
        self.viewer.eye = (2.5, 2.5, 2.5)    
